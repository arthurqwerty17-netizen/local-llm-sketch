<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Raises the per-process Jetsam memory limit for ML workloads.
       Without this the limit is ~3.3 GB; MLX model loading peaks above
       that on any model >1.5 B parameters. Required for on-device LLMs. -->
  <key>com.apple.developer.kernel.increased-memory-limit</key>
  <true/>
  <!-- Enables the extended virtual address space (57-bit VA on A12+).
       Prevents SIGBUS when MLX maps large weight files into the address
       space on devices with >4 GB of physical memory. -->
  <key>com.apple.developer.kernel.extended-virtual-addressing</key>
  <true/>
  <!-- JIT. Only honoured by sideload signing paths that preserve the
       entitlement (TrollStore always; AltStore/SideStore/Sideloadly when the
       signing profile carries `get-task-allow`). App Store review strips it.
       Needed by anything that turns generated machine code into an executable
       page at runtime — an interpreter or an emulator — and harmless when no
       such code runs. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <key>dynamic-codesigning</key>
  <true/>
</dict>
</plist>
